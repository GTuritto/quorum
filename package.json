{
  "name": "quorum-skill",
  "version": "0.1.75",
  "description": "Structured second opinions for AI coding agents: challenge implementation plans, review code, and compare approaches in Codex and Claude Code.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "coding-agents",
    "code-review",
    "implementation-planning",
    "software-architecture",
    "decision-making",
    "reasoning",
    "multi-agent",
    "codex",
    "claude-code",
    "cursor",
    "github-copilot",
    "antigravity"
  ],
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Giuseppe Turitto",
    "email": "giuseppe@turitto.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GTuritto/quorum.git"
  },
  "homepage": "https://github.com/GTuritto/quorum#readme",
  "bugs": {
    "url": "https://github.com/GTuritto/quorum/issues"
  },
  "bin": {
    "quorum-skill": "installer/install.mjs"
  },
  "files": [
    "SKILL.md",
    "VERSION",
    "agents/openai.yaml",
    "install.ps1",
    "install.sh",
    "installer/detection.mjs",
    "installer/identity.mjs",
    "installer/install.mjs",
    "installer/selector.mjs",
    "installer/targets.mjs",
    "installer/uninstall.mjs",
    "installer/version.mjs",
    "references/codex-adapter.md",
    "references/protocol.sudo.md",
    "references/memory.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dist": "node scripts/build-distribution.mjs",
    "test": "node --test tests/*.test.mjs && sh tests/test-install.sh",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "sh tests/test-install.sh"
  }
}
